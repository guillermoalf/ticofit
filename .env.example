# Supabase — copy to .env.local and fill with your project's values.
# Project Settings → API. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The service-role key bypasses RLS. It is used ONLY in server actions (never
# sent to the browser): the coach roster creates client auth users via the
# admin API. Required for "Agregar cliente" to work. Never commit the real key.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Google OAuth derives its browser-side redirect from window.location.origin,
# so make sure each origin (http://localhost:3000 and your deployed URL) is
# listed under Supabase → Authentication → URL Configuration → Redirect URLs.

# Public origin used as a fallback for SERVER-side redirects when the app runs
# behind a reverse proxy (AWS Amplify SSR). Not needed for local dev. On
# Amplify, set it in the Console to the branch's URL — it is passed into the
# build via amplify.yml.
# NEXT_PUBLIC_SITE_URL=https://staging.d21dwcaryrlr85.amplifyapp.com
